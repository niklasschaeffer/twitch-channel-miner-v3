datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String             @id @default(uuid())
  email        String             @unique
  username     String
  password     String?
  avatarUrl    String?
  provider     String             @default("local")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  streamers    Streamer[]
  settings     MinerSetting?
  statistics   StatisticalRecord[]
  logs         LogRecord[]
}

model Streamer {
  id                       String    @id @default(uuid())
  userId                   String?
  username                 String    @unique
  displayName              String
  avatar                   String
  game                     String    @default("Variety Stream")
  viewerCount              Int       @default(0)
  points                   Int       @default(0)
  watchStreak              Int       @default(0)
  isMining                 Boolean   @default(false)
  isLive                   Boolean   @default(true)
  priority                 Int       @default(1)
  enabled                  Boolean   @default(true)
  chestAvailable           Boolean   @default(false)
  nextChestEstimateSeconds Int       @default(900)
  totalPointsMined         Int       @default(0)
  lastClaimTime            String?
  uptimeMinutes            Int       @default(0)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  user                     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StatisticalRecord {
  id                   String    @id @default(uuid())
  userId               String?
  hourKey              String    // e.g. "14:00"
  pointsMined          Int       @default(0)
  claimsCount          Int       @default(0)
  raidsCount           Int       @default(0)
  predictionsWon       Int       @default(0)
  predictionsLost      Int       @default(0)
  netPredictionPoints  Int       @default(0)
  dropsCount           Int       @default(0)
  chestsPoints         Int       @default(0)
  watchTimePoints      Int       @default(0)
  channel              String?
  recordedAt           DateTime  @default(now())

  user                 User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MinerSetting {
  id                   String    @id @default(uuid())
  userId               String?   @unique
  authToken            String    @default("")
  clientId             String    @default("kimne78kx3ncx6brgo4mv6wki5h1ko")
  isSimulationMode     Boolean   @default(true)
  maxConcurrentStreams Int       @default(2)
  priorityMode         String    @default("points_asc")
  autoClaimBonus       Boolean   @default(true)
  claimDelaySeconds    Int       @default(4)
  followRaids          Boolean   @default(true)
  autoClaimDrops       Boolean   @default(true)
  autoBetPredictions   Boolean   @default(true)
  predictionStrategy   String    @default("smart_ratio")
  maxBetPoints         Int       @default(100)
  checkIntervalSeconds Int       @default(3)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user                 User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LogRecord {
  id          String    @id @default(uuid())
  userId      String?
  level       String    // INFO, CLAIM, WATCH, RAID, PREDICTION, DROP, WARN, ERROR, SUCCESS
  channel     String?
  message     String
  pointsDelta Int?
  timestamp   DateTime  @default(now())

  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
