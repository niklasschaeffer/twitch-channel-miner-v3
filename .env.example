# TWITCH_CLIENT_ID: Required. Must be the TV client id below — device-flow tokens
# pair with it for GQL viewer context. Do NOT use the id of an app you registered
# at dev.twitch.tv: its tokens pass /oauth2/validate, but every authenticated GQL
# call fails with 401 "The Authorization token is invalid".
TWITCH_CLIENT_ID="ue6666qo983tsx6so1t0vnawi233wa"

# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET: Optional. Enables "Sign in with Google"
# via the server-side authorization-code flow. Create OAuth credentials at
# https://console.cloud.google.com/apis/credentials with redirect URI:
#   <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# APP_URL: The origin where the app is hosted. Must be a real origin —
# OAuth redirect_uris break otherwise.
APP_URL="http://localhost:3000"

# SQLite database path (Prisma). The container overrides this to /app/data/miner.db.
DATABASE_URL="file:./dev.db"

# ALLOW_REGISTRATION: Optional, defaults to closed. Set to "true" to let anyone
# create a local account or a new Google-linked account via POST /api/auth/register
# and the Google OAuth callback. Even when unset/false, the very first account in
# an empty database may still self-register (bootstrap) — every account after
# that requires ALLOW_REGISTRATION="true". Existing accounts can always log in.
ALLOW_REGISTRATION="false"