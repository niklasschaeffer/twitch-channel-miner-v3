# TWITCH_CLIENT_ID: Required. The TV client id — device-flow tokens pair with it
# for GQL viewer context (balance binding). Custom client ids get HTTP 400 from GQL.
TWITCH_CLIENT_ID="ue6666qo983tsx6so1t0vnawi233wa"

# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET: Optional. Enables "Sign in with Google"
# via the server-side authorization-code flow. Create OAuth credentials at
# https://console.cloud.google.com/apis/credentials with redirect URI:
#   <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# APP_URL: The origin where the app is hosted. Must be a real origin —
# OAuth redirect_uris break otherwise.
APP_URL="http://localhost:3000"

# SQLite database path (Prisma). The container overrides this to /app/data/miner.db.
DATABASE_URL="file:./dev.db"